{
  "name": "idea-journal",
  "version": "1.0.0",
  "description": "A simple idea journal PWA",
  "main": "js/app.js",
  "type": "module",
  "scripts": {
    "dev": "npx serve . -p 3000",
    "test": "set NODE_OPTIONS=--experimental-vm-modules && jest",
    "test:unit": "npx jest tests/unit",
    "test:integration": "npx jest tests/integration",
    "test:e2e": "set NODE_OPTIONS=--experimental-vm-modules && npx jest tests/e2e",
    "build": "npx html-minifier --collapse-whitespace --remove-comments *.html -o dist/",
    "serve": "npx serve dist -p 3000"
  },
  "keywords": [
    "idea",
    "journal",
    "pwa"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "fake-indexeddb": "^6.2.5",
    "html-minifier": "^4.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^30.3.0",
    "jest-puppeteer": "^11.0.0",
    "puppeteer": "^24.40.0",
    "serve": "^14.0.0"
  },
  "dependencies": {
    "easymde": "^2.20.0"
  }
}
